def opcion():

    try:
        if Menu.get() == "ELIJA UNA OPCION": raise ValueError("Debe seleccionar una opcion")
        if Menu.get() == "CONSULTA DE HABITACIONES": Consulta_Hab()
        if Menu.get() == "SALIDA DE CLIENTES" : Salida_Hues()
