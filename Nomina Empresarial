def Archivo():
              
    #Crear archivo
    ruta = filedialog.askdirectory(title = "Eleccion de carpeta")
    if ruta:
        
        #Lista
        lista = ["Nombre", "Apellido", "Cargo", "Genero", "Salario", "Dias", "Otros ingresos", "Salud", "Pension", "Mensual"]
        
        #Ingresar datos
        archivo = open(ruta + "/Nomina.txt", "w")
        for titulo in lista:
            archivo.write(f"{titulo:<16}")
        archivo.write("\n")
        for empleado in empleados:
            for valor in lista:
                if "Mensual" not in empleado:
                    empleado["Mensual"] = (empleado["Dias"] * empleado["Salario"]) + empleado["Otros ingresos"] - empleado["Salud"] - empleado["Pension"]
                archivo.write(f"{empleado[valor]:<16}")
            archivo.write("\n")

        archivo.write("Nomina total de la empresa --->" + "\t" + str(total))
        
        messagebox.showinfo("FELICIDADES", "Se a guardado el archivo")
        
        #Guardar archivo        
        archivo.close()
               
