    #Genero
    tk.Label(frame, text = "Genero --> ", font = ("Arial", 10), bg = "gray10", fg = "spring green").grid(row = 3, column = 0, padx = 20, sticky = "w")
    frame_genero = tk.Frame(frame, width = 1)
    frame_genero.grid(row = 3, column = 1)
    var_genero = tk.StringVar(value = "Hombre")
    hombre = tk.Radiobutton(frame_genero, text = "Hombre", variable = var_genero, value = "Hombre", bg = "gray10", fg = "spring green", selectcolor = "gray10" )
