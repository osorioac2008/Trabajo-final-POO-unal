def Salida_Hues():
    
    global Subventana_2, hab
    
    def Retirar_hab():   
                
        try:
            if hab.get() == "":
                raise ValueError("Campo Vacio")
            if hab.get().upper() not in Habs_120 and hab.get().upper() not in Habs_160:
                raise ValueError("Caracter erroneo de reconocimiento de habitacion")
            if Habs_120.get(hab.get().upper()) == "Disponible":
                raise ValueError("La habitacion esta disponible, No es tu habitacion")
            if Habs_160.get(hab.get().upper()) == "Disponible":
                raise ValueError("La habitacion esta disponible, No es tu habitacion")
            
            Registrar_salida(hab.get().upper())
        
        except ValueError as x:
            messagebox.showerror("FALLO DE INGRESO", x)       
            return
    
    #Iniciador ventana
    Subventana_2 = tk.Toplevel(ventana)
    Subventana_2.title("SALIDA DE HUESPEDES")
    Subventana_2.grab_set()
    Subventana_2.transient(ventana)
    Subventana_2.configure(bg = "gray20")
    
    #Titulo
    tk.Label(Subventana_2, text = "REGISTRO DE SALIDA DE HUESPEDES", fg = "yellow2", bg = "gray20", font = ("Comic Sans MS", 16)).pack(pady = 20, padx = 10)
    
    #Subtitulo
    tk.Label(Subventana_2, text = "Lamentamos que tenga que despedirse del hotel", fg = "yellow2", bg = "gray20", font = ("Comic Sans MS", 16)).pack(pady = 20, padx = 10)
    
    #habitacion
    tk.Label(Subventana_2, text = "Ingrese porfavor su habitacion", fg = "yellow2", bg = "gray20", font = ("Comic Sans MS", 12)).pack(pady = 20, padx = 10)
    hab = tk.Entry(Subventana_2, bg = "yellow2", fg = "gray20", justify = "center")
    hab.pack(pady = 10)
    tk.Button(Subventana_2, text = ">>> Continuar <<<", command = Retirar_hab, bg = "yellow2", fg = "gray20", font = ("Comic Sans MS", 10, "bold")).pack(pady = 15)

