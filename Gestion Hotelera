# 2.1 SUBVENTANA N.1 (CONSULTAR HABITACIONES)
#-------------------------------------------------------------------------------

def Consulta_Hab():
    
    global Subventana, listado
    
    #Funcion datos
    def ocupar_hab():
        
        try:
            eleccion = listado.focus()
            if eleccion == "":
                raise ValueError("Debe seleccionar una habitacion")
            datos = listado.item(eleccion)["values"]
            if datos[1] == "Ocupado":
                raise ValueError("La habitacion esta ocupada")
            Ingreso_huesped()
            
        except ValueError as x:
            messagebox.showwarning("ADVERTENCIA", x)
            return   
    
    #Iniciador ventana
    Subventana = tk.Toplevel(ventana)
    Subventana.title("CONSULTORIO DE HABITACIONES")
    Subventana.grab_set()
    Subventana.transient(ventana)
    Subventana.configure(bg = "gray20")
    
    #Titulo
    tk.Label(Subventana, text = "ANALISIS DE HABITACIONES", fg = "yellow2", bg = "gray20", font = ("Comic Sans MS", 20)).pack(pady = 20, padx = 10)
    
    #Subtitulo
    tk.Label(Subventana, text = "A continuacion presentamos las habitaciones, su estado y valor:", fg = "yellow2", bg = "gray20", font = ("Comic Sans MS", 16)).pack(pady = 10, padx = 10)
    
    #Frame
    frame = tk.Frame(Subventana, width = 1)
    frame.pack(fill = "x", pady = 10, padx = 10)
    frame.configure(bg = "gray20")
    
    #habitaciones
    
    Hab = ("Habitacion", "Disponibilidad", "Valor")
    
    listado = ttk.Treeview(Subventana, columns = Hab, height = 10, show = "headings")
    listado.pack(fill = "x", pady = 10, padx = 20)
    
    for i in Hab:
        listado.heading(i, text = i)
        listado.column(i, width = 200, anchor = "center")
    
    for hab, disp in Habs_120.items():
        listado.insert("", tk.END, value = (
            hab,
            disp,
            120000
        ))
    
    for hab, disp in Habs_160.items():
        listado.insert("", tk.END, value = (
            hab,
            disp,
            160000
        ))
       
    tk.Button(Subventana, text = "Elejir habitacion", command = ocupar_hab, bg = "yellow2", fg = "gray20", font = ("Comic Sans MS", 10, "bold")).pack(pady = 10)

