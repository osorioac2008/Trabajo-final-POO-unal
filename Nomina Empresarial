    #frame empleado
    frame = tk.Frame(Subventana_1, width = 1, bg = "gray10")
    frame.pack(fill = "x")
    frame.grid_columnconfigure((0, 1), weight = 1)
    
    #Nombre
    tk.Label(frame, text = "Nombre --> ", font = ("Arial", 10), bg = "gray10", fg = "spring green").grid(row = 0, column = 0, padx = 20, sticky = "w")
