def Agregar_empleado():
    
    # Funcion
    def crear_empleado():
        
        try:
            #Verificacion vacios
            Var = [var_nom, var_ape, var_genero, var_Sal, var_ing, var_sal, var_pen]
            if not all(var.get().strip() for var in Var):
                raise ValueError("Faltan campos vacios")

            #Crear empleado
            persona = {
                "Nombre" : var_nom.get(),
                "Apellido" : var_ape.get(),
                "Cargo" : var_cargo.get(),
                "Genero" : var_genero.get(),
                "Salario" : float(var_Sal.get()),
                "Dias" : float(var_dias.get()),
                "Otros ingresos" : float(var_ing.get()),
                "Salud" : float(var_sal.get()),
                "Pension" : float(var_pen.get())
            }
             
        except ValueError as x:
            messagebox.showwarning("ADVERTENCIA", x) 
            return
    
        empleados.append(persona)  
        messagebox.showinfo("FELICITACIONES", "Usuario creado con exito en la base de datos")
        Subventana_1.destroy()
            
    #Inicio ventana
    Subventana_1 = tk.Toplevel(ventana)
    Subventana_1.title("AGREGAR EMPLEADOS")
    Subventana_1.grab_set()
    Subventana_1.transient(ventana)
    Subventana_1.configure(bg = "gray10")
    Subventana_1.resizable(False, False)
    
    #Titulo
